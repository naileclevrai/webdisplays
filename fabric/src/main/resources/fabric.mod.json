{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "WebDisplays is a mod for creating and interacting with web browsers in Minecraft. Multiloader build (Forge/Fabric).",
  "authors": ["CinemaMod Group"],
  "contact": {
    "homepage": "https://modrinth.com/mod/webdisplays",
    "issues": "https://github.com/CinemaMod/webdisplays/issues",
    "sources": "https://github.com/CinemaMod/webdisplays"
  },
  "license": "LGPL-2.1-or-later",
  "environment": "*",
  "entrypoints": {
    "main": ["net.montoyo.wd.fabric.WebDisplaysFabric"],
    "client": ["net.montoyo.wd.fabric.WebDisplaysFabricClient"]
  },
  "mixins": ["webdisplays.mixins.json"],
  "accessWidener": "webdisplays.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "mcef": "*"
  }
}
